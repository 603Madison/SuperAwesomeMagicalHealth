# A Podman Quadlet: the server as a systemd service (it shows in Cockpit's Podman and Services pages).
#
#   Rootless: copy to ~/.config/containers/systemd/, then
#     systemctl --user daemon-reload && systemctl --user start superawesomemagicalhealth
#     loginctl enable-linger $USER     (keeps it running when you're logged out)
#   System-wide: copy to /etc/containers/systemd/, then
#     sudo systemctl daemon-reload && sudo systemctl start superawesomemagicalhealth
#
# The first start logs the break-glass admin's password:
#   journalctl --user -u superawesomemagicalhealth | grep -A3 "break-glass"

[Unit]
Description=SuperAwesomeMagicalHealth server
Wants=network-online.target
After=network-online.target

[Container]
Image=ghcr.io/603madison/superawesomemagicalhealth:latest
ContainerName=superawesomemagicalhealth
PublishPort=8090:8080
# A named volume; or a folder, e.g. Volume=%h/superawesomemagicalhealth:/data:Z
Volume=superawesomemagicalhealth-data:/data:Z
Environment=TZ=America/New_York
# Environment=SAMH_PUBLIC_URL=https://health.example.com
# Environment=SAMH_TRUST_PROXY=true
# Secrets are better in a file only you can read:
# EnvironmentFile=%h/.config/superawesomemagicalhealth.env
AutoUpdate=registry
HealthCmd=wget -qO /dev/null http://127.0.0.1:8080/api/health || exit 1
HealthInterval=30s

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
